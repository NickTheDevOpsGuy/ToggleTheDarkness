# ------------------------------------------------------------
# Node / React / TypeScript / Vite project .gitignore
# Works great on macOS
# ------------------------------------------------------------

# Node modules
node_modules/

# Build output
dist/
build/

# TypeScript build artifacts
*.js.map
*.d.ts
*.tsbuildinfo
vite.config.js

# Coverage
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Windows system files
Thumbs.db
Desktop.ini

# ESLint cache
.eslintcache

# Optional npm cache
.npm/

# Miscellaneous
.nyc_output/

# ------------------------------------------------------------
# macOS system files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes